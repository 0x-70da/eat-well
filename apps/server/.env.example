# ==============================================================================
# Eat Well Server - Environment Variables Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS & Better Auth)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Configuration (PostgreSQL 15+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eatwell_db
# Local Docker or external PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eatwell_db

# Better-Auth Configuration
# Run `openssl rand -base64 32` to generate a secure secret
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_here_min_32_chars
BETTER_AUTH_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Stripe Online Payments Configuration
# ------------------------------------------------------------------------------
# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
# Stripe Publishable Key (for frontend use, starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
# Stripe Webhook Signing Secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# ------------------------------------------------------------------------------
# Paymob Egyptian Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Paymob API Key from Accept Dashboard Settings
PAYMOB_API_KEY=your_paymob_api_key_from_dashboard
# Paymob Secret Key
PAYMOB_SECRET_KEY=your_paymob_secret_key
# Paymob Public Key
PAYMOB_PUBLIC_KEY=your_paymob_public_key
# Paymob HMAC Secret Key for Webhook and Transaction verification
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_from_account_settings
# Paymob Online Card Integration ID (Credit/Debit Card)
PAYMOB_CARD_INTEGRATION_ID=123456
# Paymob Mobile Wallets Integration ID (Vodafone Cash, Orange Cash, etc.)
PAYMOB_WALLET_INTEGRATION_ID=234567
# Paymob InstaPay Integration ID (if enabled on account)
PAYMOB_INSTAPAY_INTEGRATION_ID=345678
# Paymob Iframe ID for hosted card checkout
PAYMOB_IFRAME_ID=456789

# ------------------------------------------------------------------------------
# Image Hosting & Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Email Notifications & Service (Optional / SMTP / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@eatwell-restaurant.com
RESEND_API_KEY=your_resend_api_key_here
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Eat Well Restaurant <no-reply@eatwell-restaurant.com>"
